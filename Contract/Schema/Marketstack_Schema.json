
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketstack Historical Stock Prices Contract",
  "description": "Data contract for Microsoft (MSFT) end-of-day stock prices sourced from the Marketstack API.",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "const": "MSFT",
      "description": "Stock ticker symbol"
    },
    "exchange": {
      "type": ["string", "null"],
      "description": "Stock exchange identifier"
    },
    "trade_date": {
      "type": "string",
      "format": "date",
      "description": "Stock trading date"
    },
    "open_price": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Opening stock price"
    },
    "high_price": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Highest trading price"
    },
    "low_price": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Lowest trading price"
    },
    "close_price": {
      "type": "number",
      "minimum": 0,
      "description": "Closing stock price"
    },
    "adjusted_close": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Adjusted closing stock price"
    },
    "volume": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Number of shares traded"
    },
    "source": {
      "type": "string",
      "const": "marketstack",
      "description": "API data provider"
    },
    "batch_id": {
      "type": "string",
      "description": "Ingestion batch identifier"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Original ingestion timestamp"
    },
    "bronze_loaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Bronze processing timestamp"
    }
  },
  "required": [
    "symbol",
    "trade_date",
    "close_price",
    "source",
    "batch_id",
    "ingested_at",
    "bronze_loaded_at"
  ],
  "additionalProperties": false
}
