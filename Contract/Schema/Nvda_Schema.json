
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NVDA Historical Stock Prices Contract",
  "description": "Data contract for NVIDIA Corporation (NVDA) daily historical stock prices.",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "const": "NVDA",
      "description": "Stock ticker symbol"
    },
    "trade_date": {
      "type": "string",
      "format": "date",
      "description": "Stock trading date"
    },
    "open_price": {
      "type": "number",
      "minimum": 0,
      "description": "Opening stock price"
    },
    "high_price": {
      "type": "number",
      "minimum": 0,
      "description": "Highest stock price"
    },
    "low_price": {
      "type": "number",
      "minimum": 0,
      "description": "Lowest stock price"
    },
    "close_price": {
      "type": "number",
      "minimum": 0,
      "description": "Closing stock price"
    },
    "adjusted_close": {
      "type": ["number", "null"],
      "minimum": 0,
      "description": "Adjusted closing stock price"
    },
    "volume": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of shares traded"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "description": "Market data API provider"
    },
    "batch_id": {
      "type": "string",
      "description": "Ingestion batch identifier"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Original ingestion timestamp"
    },
    "bronze_loaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Bronze processing timestamp"
    }
  },
  "required": [
    "symbol",
    "trade_date",
    "open_price",
    "high_price",
    "low_price",
    "close_price",
    "volume",
    "source",
    "batch_id",
    "ingested_at",
    "bronze_loaded_at"
  ],
  "additionalProperties": false
}
