
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alpha Vantage Stock Prices Contract",
  "description": "Data contract for Microsoft (MSFT) daily stock prices sourced from Alpha Vantage.",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "const": "MSFT",
      "description": "Stock ticker symbol"
    },
    "trade_date": {
      "type": "string",
      "format": "date",
      "description": "Trading date"
    },
    "open": {
      "type": "string",
      "description": "Opening stock price"
    },
    "high": {
      "type": "string",
      "description": "Highest stock price"
    },
    "low": {
      "type": "string",
      "description": "Lowest stock price"
    },
    "close": {
      "type": "string",
      "description": "Closing stock price"
    },
    "volume": {
      "type": "string",
      "description": "Number of shares traded"
    },
    "source": {
      "type": "string",
      "const": "alpha_vantage",
      "description": "API data provider"
    },
    "batch_id": {
      "type": "string",
      "description": "Ingestion batch identifier"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time",
      "description": "Original ingestion timestamp"
    },
    "bronze_loaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Bronze processing timestamp"
    }
  },
  "required": [
    "symbol",
    "trade_date",
    "open",
    "high",
    "low",
    "close",
    "volume",
    "source",
    "batch_id",
    "ingested_at",
    "bronze_loaded_at"
  ],
  "additionalProperties": false
}
